  "item": [
    {
      "name": "A0 Register customer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/register",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "auth": {"type":"noauth"},
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Postman Customer\",\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}",
          "options": {"raw":{"language":"json"}}
        }
      },
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
        "if(pm.response.code===201){const u=pm.response.json().data.user;pm.expect(u.role).to.eql(\"customer\");pm.collectionVariables.set(\"profile_user_id\",u.id);}"
      ]}}]
    },
    {
      "name": "A1 Chưa đăng nhập -> 401",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "A2 Đăng nhập Admin",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/admin/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{admin_email}}\", \"password\": \"{{admin_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json().data;pm.collectionVariables.set(\"admin_token\",d.access_token);pm.collectionVariables.set(\"admin_refresh_token\",d.refresh_token);}"
            ]
          }
        }
      ]
    },
    {
      "name": "A3 Thông tin đăng nhập",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/auth/me",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "A4 Khách login Admin -> 403",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/admin/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{customer_email}}\", \"password\": \"{{customer_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "A5 Login khách thông thường",
