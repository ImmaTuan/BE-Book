{
  "info": {
    "name": "CRUD Sách + Login Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "book_id",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "admin_email",
      "value": "admin@bookstore.local"
    },
    {
      "key": "admin_password",
      "value": "Admin123456!"
    },
    {
      "key": "customer_email",
      "value": "customer@bookstore.local"
    },
    {
      "key": "customer_password",
      "value": "Customer123456!"
    }
  ],
  "item": [
    {
      "name": "A1 Chưa đăng nhập -> 401",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "A2 Đăng nhập Admin",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/admin/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{admin_email}}\", \"password\": \"{{admin_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"admin_token\",pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "A3 Thông tin đăng nhập",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/auth/me",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "A4 Khách login Admin -> 403",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/admin/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{customer_email}}\", \"password\": \"{{customer_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "A5 Login khách thông thường",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{customer_email}}\", \"password\": \"{{customer_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set(\"customer_token\",pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "A6 Khách gọi API Admin -> 403",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\",()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Lấy thể loại",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/categories",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data;",
              "pm.test(\"Có thể loại để chọn\",()=>pm.expect(d.length).to.be.above(0));",
              "if(d.length) pm.collectionVariables.set(\"category_id\",d[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Thêm sách",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/admin/books",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_id\": {{category_id}},\n  \"title\": \"Sách test Postman\",\n  \"price\": 100000,\n  \"stock_quantity\": 10,\n  \"weight_grams\": 300,\n  \"description\": \"Dữ liệu test CRUD\",\n  \"publisher\": \"NXB Demo\",\n  \"publication_year\": 2026\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set(\"book_id\",pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Danh sách",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books?page=1&limit=20",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Chi tiết sách vừa tạo",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books/{{book_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Sửa giá và tên",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/books/{{book_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sách đã sửa\",\n  \"price\": 125000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Sửa tồn bằng PUT",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/admin/books/{{book_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock_quantity\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Tìm kiếm",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books?search=Postman&page=1&limit=10",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Test giá âm (phải lỗi 400)",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/books/{{book_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Xóa sách vừa tạo",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/admin/books/{{book_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Kiểm tra đã xóa (404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/books/{{book_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  }
}
